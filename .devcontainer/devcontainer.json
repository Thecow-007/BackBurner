{
  "name": "BackBurner",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "docker-compose.devcontainer.yml"
  ],
  "service": "devcontainer",
  "workspaceFolder": "/workspaces/BackBurner",
  "runServices": ["postgres", "devcontainer"],
  "shutdownAction": "stopCompose",
  "forwardPorts": [3000, 5432],
  "postCreateCommand": "npm ci",
  // base:ubuntu ships a native `vscode` user (what Codespaces provisions its
  // agent as), and the node feature installs Node 22 system-wide so it is on
  // PATH for that user — the typescript-node image kept Node under its own
  // `node` user's nvm profile, unreachable once Codespaces forced `vscode`.
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    // base:ubuntu ships no SSH server; Codespaces (and `gh codespace ssh`)
    // need one in the container to connect.
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  }
}
