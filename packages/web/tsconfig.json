{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // Browser data layer: EventSource, fetch, localStorage, AbortController,
    // window come from the DOM lib, not @types/node. Kept on the repo's
    // NodeNext resolution (so relative imports carry .js) for `tsc -b`
    // consistency; a future Vite build can switch to bundler resolution.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": ["src"]
}
