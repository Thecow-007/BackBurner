# BackBurner runtime configuration (docs/architecture.md §13).
# Copy to .env and fill in for local overrides; never commit the real file
# (.gitignore already excludes .env / .env.*).

# Required. PostgreSQL connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/backburner_dev

# HTTP listen port for the api.
PORT=3000

# Maximum concurrently running workers (tests/demo use 2).
WORKER_CONCURRENCY=4

# Retry backoff base in ms; delay = base * 2^(attempts-1) +/- 25% jitter
# (tests use ~100).
BACKOFF_BASE_MS=2000

# Interval for SSE heartbeat comments, keeps proxies from dropping idle
# streams (docs/deployment.md §4).
SSE_HEARTBEAT_MS=20000

# Bound on the graceful-drain window in stop({ drain }); on expiry remaining
# workers are aborted and recover on next boot (tests set this low).
DRAIN_TIMEOUT_MS=30000

# Standard Node environment flag.
NODE_ENV=development
