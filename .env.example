# BackBurner runtime configuration (docs/architecture.md §13).
# Copy to .env and fill in for local overrides; never commit the real file
# (.gitignore already excludes .env / .env.*).
#
# This file serves two audiences:
#   - Local dev: the api, `npm run migrate`, and `npm run seed` read these
#     from the environment directly.
#   - The production server: docker compose loads .env from the deploy
#     directory automatically, using it both to interpolate docker-compose.yml
#     and to configure the app container (docs/deployment.md §6).

# Required for local dev. In production this is composed by docker-compose.yml
# from POSTGRES_PASSWORD and POSTGRES_DB below — do not set it on the server,
# or the container will be pointed at a host that does not exist inside it.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/backburner_dev

# HTTP listen port for the api.
PORT=3000

# Maximum concurrently running workers (tests/demo use 2).
WORKER_CONCURRENCY=4

# Retry backoff base in ms; delay = base * 2^(attempts-1) +/- 25% jitter
# (tests use ~100).
BACKOFF_BASE_MS=2000

# Interval for SSE heartbeat comments, keeps proxies from dropping idle
# streams (docs/deployment.md §4). Five heartbeats inside Cloudflare's ~100s
# idle window; raising this past ~90s will silently break the live dashboard
# in production.
SSE_HEARTBEAT_MS=20000

# Bound on the graceful-drain window in stop({ drain }); on expiry remaining
# workers are aborted and recover on next boot (tests set this low). Must stay
# below docker-compose.yml's stop_grace_period for the drain to complete.
DRAIN_TIMEOUT_MS=30000

# Standard Node environment flag.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Production only — consumed by docker-compose.yml's prod profile.
# ---------------------------------------------------------------------------

# Database credentials and name. POSTGRES_DB creates the database on first
# volume init only; on an existing volume, create it by hand first.
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=backburner

# The image the server runs. Defaults to the moving tag the deploy workflow
# republishes on every green push to main; pin to a :sha tag to roll back.
# APP_IMAGE=ghcr.io/thecow-007/backburner:main

# The pre-existing Docker network the cloudflared container sits on. The app
# joins it with the alias `backburner`, so the tunnel's public-hostname route
# is http://backburner:3000.
# EDGE_NETWORK=cloudflared
