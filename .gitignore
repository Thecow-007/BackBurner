# Editors / local tooling
.obsidian/
.vscode/
.idea/

# Node
node_modules/
dist/
coverage/
*.tsbuildinfo

# Defensive: compiled TS artifacts belong in dist/, never beside .ts sources
# (a stray `tsc` without -b can emit next to sources; keep them out of git).
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map
packages/*/test/**/*.js
packages/*/test/**/*.js.map
packages/*/test/**/*.d.ts
packages/*/test/**/*.d.ts.map

# e2e harness server logs (test-plan.md §3.1)
packages/e2e/.logs/

# Environment & secrets
.env
.env.*
!.env.example

# OS noise
.DS_Store
Thumbs.db
